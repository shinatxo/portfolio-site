{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SyncSiteToBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::shinaoguntoye.dev",
        "arn:aws:s3:::shinaoguntoye.dev/*"
      ]
    },
    {
      "Sid": "InvalidateCloudFront",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::061051247394:distribution/E3NBBE6Y8R7MCC"
    }
  ]
}
